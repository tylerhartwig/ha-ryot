# Copy to .env (gitignored). Read by scripts/ryot_stack.py and scripts/smoke_live.py.

# --- Your real Ryot (only for scripts/smoke_live.py; tests never touch it) ---
RYOT_URL=https://ryot.example.com
# Either an API token (Ryot -> Settings -> Integrations -> Create API token; expires
# after USERS_TOKEN_VALID_FOR_DAYS, default 90) ...
RYOT_API_TOKEN=
# ... or username/password (the integration re-logs in when the session expires).
RYOT_USERNAME=
RYOT_PASSWORD=

# --- Isolated test stack (scripts/ryot_stack.py, pytest) ---
# Ryot image tag the throwaway backend is pulled from (ghcr.io/ignisda/ryot).
RYOT_TEST_VERSION=v10.5.6
# Set to reuse an already-running stack instead of booting one per pytest session.
# RYOT_TEST_URL=http://127.0.0.1:8055
